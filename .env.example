# ---------------------------------------------------------------------------
# Pick ONE provider.  Copy this file to .env and fill in the key.
#   anthropic  = Anthropic Messages API
#   openai     = any OpenAI-compatible /chat/completions endpoint
#                (OpenAI, OpenRouter, Together, Groq, vLLM, LM Studio, Ollama…)
#   mock       = no network, no key — for trying the app out
# ---------------------------------------------------------------------------
PROVIDER=anthropic

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# --- OpenAI-compatible -----------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   LM Studio:  http://localhost:1234/v1        (key not required)
#   Ollama:     http://localhost:11434/v1       (key not required)
#   vLLM:       http://localhost:8000/v1
# Some compatible servers reject response_format; set this to false if so.
# OPENAI_JSON_MODE=true

# --- Model -----------------------------------------------------------------
# Must be a vision-capable model your key can reach. Examples:
#   Anthropic:   claude-sonnet-4-6
#   OpenAI:      gpt-4.1  /  gpt-4.1-mini
#   OpenRouter:  anthropic/claude-sonnet-4.6
#   Local:       qwen2.5-vl-7b-instruct
MODEL=claude-sonnet-4-6

# --- Behaviour -------------------------------------------------------------
# TEMPERATURE=0            # sampling temperature; some endpoints (e.g. Kimi
                           # coding) only accept a specific value like 1
CONCURRENCY=3              # pages analysed in parallel
MAX_PAGES=60               # pages past this are ignored
MAX_UPLOAD_MB=40
MAX_OUTPUT_TOKENS=2000
REQUEST_TIMEOUT=180        # seconds per request
CROSS_PAGE_PASS=true       # second pass looking for contradictions between pages
DOC_TTL_MINUTES=180        # how long an uploaded PDF stays in memory
