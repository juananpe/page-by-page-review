#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
PYTHON="$REPO_ROOT/.venv/bin/python"
FIXTURE="$SCRIPT_DIR/make-fixture-pdf.py"

fail() {
  printf 'control-page-review: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'usage:' \
    '  control-page-review launch --run-dir /tmp/page-by-page-review-verify-ID --port PORT' \
    '  control-page-review doctor --run-dir /tmp/page-by-page-review-verify-ID --port PORT' \
    '  control-page-review cleanup --run-dir /tmp/page-by-page-review-verify-ID --port PORT'
}

validate_run_dir() {
  case "$1" in
    /tmp/page-by-page-review-verify-*) ;;
    *) fail "run directory must match /tmp/page-by-page-review-verify-*" ;;
  esac
  [ ! -L "$1" ] || fail "run directory must not be a symlink"
}

validate_port() {
  case "$1" in
    ''|*[!0-9]*) fail "port must be numeric" ;;
  esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || fail "port must be between 1024 and 65535"
}

parse_args() {
  ACTION="${1:-}"
  [ -n "$ACTION" ] || { usage; exit 2; }
  shift || true
  RUN_DIR=""
  PORT=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --run-dir) [ "$#" -ge 2 ] || fail "--run-dir needs a value"; RUN_DIR="$2"; shift 2 ;;
      --port) [ "$#" -ge 2 ] || fail "--port needs a value"; PORT="$2"; shift 2 ;;
      *) fail "unknown argument: $1" ;;
    esac
  done
  [ -n "$RUN_DIR" ] && [ -n "$PORT" ] || fail "--run-dir and --port are required"
  validate_run_dir "$RUN_DIR"
  validate_port "$PORT"
}

process_command() {
  ps -p "$1" -o command= 2>/dev/null || true
}

validate_owned_process() {
  local pid="$1" command cwd
  command="$(process_command "$pid")"
  [ -n "$command" ] || fail "recorded process $pid is not running"
  case "$command" in
    *"$PYTHON"*"-m uvicorn app.main:app"*"--port $PORT"*) ;;
    *) fail "recorded PID $pid is not the expected verifier Uvicorn command" ;;
  esac
  cwd="$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | awk '/^n/{sub(/^n/, ""); print; exit}')"
  [ "$cwd" = "$REPO_ROOT" ] || fail "recorded PID $pid is not running from $REPO_ROOT"
  lsof -nP -a -p "$pid" -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1 || \
    fail "recorded PID $pid does not own listening port $PORT"
}

doctor_config() {
  curl --fail --silent --show-error "http://127.0.0.1:$PORT/api/config" | "$PYTHON" -c '
import json, sys
c = json.load(sys.stdin)
expected = {"provider": "mock", "model": "mock", "ready": True, "cross_page": True}
bad = {k: (c.get(k), v) for k, v in expected.items() if c.get(k) != v}
if bad:
    raise SystemExit(f"unexpected config: {bad}")
print(json.dumps(c, sort_keys=True))
'
}

launch() {
  [ -x "$PYTHON" ] || fail "missing executable $PYTHON"
  [ ! -e "$RUN_DIR" ] || fail "run directory already exists: $RUN_DIR"
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    fail "port $PORT is already listening; choose another port"
  fi

  mkdir -p "$RUN_DIR/evidence" "$RUN_DIR/scratch"
  "$PYTHON" "$FIXTURE" "$RUN_DIR/scratch/verification-paper.pdf" >/dev/null
  printf '%s\n' "$PORT" > "$RUN_DIR/port"

  cd "$REPO_ROOT"
  env \
    PROVIDER=mock \
    MODEL=mock \
    CROSS_PAGE_PASS=true \
    DOC_TTL_MINUTES=30 \
    "$PYTHON" -m uvicorn app.main:app --host 127.0.0.1 --port "$PORT" \
    > "$RUN_DIR/evidence/server.log" 2>&1 &

  local pid="$!" ready=0
  printf '%s\n' "$pid" > "$RUN_DIR/pid"
  for _ in $(seq 1 50); do
    if curl --fail --silent "http://127.0.0.1:$PORT/api/config" >/dev/null 2>&1; then
      ready=1
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    sleep 0.2
  done
  if [ "$ready" -ne 1 ]; then
    if kill -0 "$pid" 2>/dev/null; then kill "$pid" 2>/dev/null || true; fi
    fail "server did not become ready; inspect $RUN_DIR/evidence/server.log"
  fi

  validate_owned_process "$pid"
  doctor_config > "$RUN_DIR/evidence/config.json"
  git -C "$REPO_ROOT" rev-parse HEAD > "$RUN_DIR/evidence/revision.txt"
  printf 'launch ok: pid=%s port=%s fixture=%s\n' "$pid" "$PORT" "$RUN_DIR/scratch/verification-paper.pdf"
  wait "$pid" || true
}

doctor() {
  [ -d "$RUN_DIR" ] || fail "run directory does not exist: $RUN_DIR"
  [ -f "$RUN_DIR/pid" ] && [ -f "$RUN_DIR/port" ] || fail "run directory has no recorded PID/port"
  local recorded_port pid
  recorded_port="$(tr -d '[:space:]' < "$RUN_DIR/port")"
  [ "$recorded_port" = "$PORT" ] || fail "requested port does not match recorded port $recorded_port"
  pid="$(tr -d '[:space:]' < "$RUN_DIR/pid")"
  case "$pid" in ''|*[!0-9]*) fail "recorded PID is invalid" ;; esac
  validate_owned_process "$pid"
  doctor_config
  printf 'doctor ok: pid=%s port=%s run_dir=%s\n' "$pid" "$PORT" "$RUN_DIR"
}

cleanup() {
  [ -d "$RUN_DIR" ] || fail "run directory does not exist: $RUN_DIR"
  if [ -f "$RUN_DIR/port" ]; then
    local recorded_port
    recorded_port="$(tr -d '[:space:]' < "$RUN_DIR/port")"
    [ "$recorded_port" = "$PORT" ] || fail "requested port does not match recorded port $recorded_port"
  fi

  if [ -f "$RUN_DIR/pid" ]; then
    local pid command
    pid="$(tr -d '[:space:]' < "$RUN_DIR/pid")"
    case "$pid" in ''|*[!0-9]*) fail "recorded PID is invalid" ;; esac
    if kill -0 "$pid" 2>/dev/null; then
      validate_owned_process "$pid"
      kill "$pid"
      for _ in $(seq 1 50); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -0 "$pid" 2>/dev/null && fail "process $pid did not stop after TERM"
    fi
    unlink "$RUN_DIR/pid"
  fi
  [ ! -f "$RUN_DIR/port" ] || unlink "$RUN_DIR/port"
  if [ -d "$RUN_DIR/scratch" ]; then
    find "$RUN_DIR/scratch" -depth -delete
  fi
  [ -d "$RUN_DIR/evidence" ] || fail "evidence directory is missing"
  printf 'cleanup ok: evidence preserved at %s/evidence\n' "$RUN_DIR"
}

parse_args "$@"
case "$ACTION" in
  launch) launch ;;
  doctor) doctor ;;
  cleanup) cleanup ;;
  *) usage; exit 2 ;;
esac
